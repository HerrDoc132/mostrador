# Base de datos
# Para desarrollo local (SQLite en archivo):
DATABASE_URL="file:local.db"

# Para producción en Turso (libSQL):
# TURSO_DATABASE_URL="libsql://gestion-almacen.turso.io"
# TURSO_AUTH_TOKEN="tu_token_aqui"

# Autenticación y sesión
# Secreto para firma de cookies de sesión (generar con `openssl rand -base64 32`)
SESSION_SECRET="cambiar_este_secreto_super_seguro_para_produccion_minimo_32_chars"

# Entorno
NODE_ENV="development"
